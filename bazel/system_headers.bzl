"""Repository rule that enumerates C and C++ standard library headers outside of Bazel.

On macOS, toolchains_llvm compiles against the SDK's libc++ and libc headers (via `--sysroot` and
`-cxx-isystem <sdk>/usr/include/c++/v1`), which are not Bazel files. Crubit needs to know every
header path clang may read for the standard library so that `//support/cc_std` can claim ownership
of them, and Starlark cannot list directories during analysis. This rule lists them at fetch time.

The headers listed are all of libc++, plus the C library headers that the public standard library
headers (`public_hdrs`) transitively include. Other SDK headers (e.g. curl or libxml2) are left out,
so that `//support/cc_std` doesn't claim ownership of libraries that aren't part of it.

The generated `@crubit_system_headers//:headers.bzl` defines:
  * `SYSROOT`: the absolute sysroot path the headers were found under ("" if none).
  * `HEADERS`: header paths relative to `SYSROOT` (e.g. "usr/include/c++/v1/vector").
"""

def _darwin_sdk_path(rctx):
    # Matches how toolchains_llvm picks the default macOS sysroot.
    rctx.getenv("DEVELOPER_DIR")
    result = rctx.execute(["/usr/bin/xcrun", "--show-sdk-path", "--sdk", "macosx"])
    if result.return_code:
        fail("Failed to detect macOS SDK path:\n%s\n%s" % (result.stdout, result.stderr))
    return result.stdout.strip()

def _list_files(rctx, directory):
    # `-L` lists headers reached through symlinks under the symlink's name, which is the path
    # clang reports for them.
    result = rctx.execute(["/usr/bin/find", "-L", directory, "-type", "f"])
    if result.return_code:
        fail("Failed to list headers in %s:\n%s" % (directory, result.stderr))
    return result.stdout.splitlines()

def _included_headers(rctx, sysroot):
    """Returns the paths of all headers transitively included by `public_hdrs`."""
    rctx.file("public_hdrs.cc", "".join(["#include <%s>\n" % h for h in rctx.attr.public_hdrs]))
    result = rctx.execute([
        "/usr/bin/xcrun",
        "--sdk",
        "macosx",
        "clang++",
        "-isysroot",
        sysroot,
        "-std=c++20",
        "-fsyntax-only",
        "-H",
        "public_hdrs.cc",
    ])
    rctx.delete("public_hdrs.cc")
    if result.return_code:
        fail("Failed to find the headers included by the standard library:\n%s" % result.stderr)

    # `-H` prints one line per included header: one or more dots, a space, then the path.
    return [
        line.lstrip(".").strip()
        for line in result.stderr.splitlines()
        if line.startswith(".")
    ]

def _crubit_system_headers_impl(rctx):
    sysroot = ""
    headers = []
    if rctx.os.name.startswith("mac"):
        sysroot = _darwin_sdk_path(rctx)
        include_dir = sysroot + "/usr/include"
        rctx.watch_tree(include_dir)
        prefix = sysroot + "/"
        headers = sorted({
            path.removeprefix(prefix): None
            for path in _list_files(rctx, include_dir + "/c++/v1") + _included_headers(rctx, sysroot)
            if path.startswith(prefix)
        }.keys())

    rctx.file("BUILD.bazel", 'exports_files(["headers.bzl"])\n')
    rctx.file("headers.bzl", "\n".join([
        '"""Generated by @rules_crubit//bazel:system_headers.bzl."""',
        "",
        "SYSROOT = %s" % json.encode(sysroot),
        "",
        "HEADERS = %s" % json.encode_indent(headers, indent = "    "),
        "",
    ]))

crubit_system_headers = repository_rule(
    implementation = _crubit_system_headers_impl,
    attrs = {
        "public_hdrs": attr.string_list(
            doc = "The public standard library headers, as they would be `#include`d.",
        ),
    },
    local = True,
)
